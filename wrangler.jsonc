{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaro-cleaning",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jaro-cleaning-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "jaro-cleaning-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "ADMIN_EMAILS": ""
  }
}
